# CineConnect Python Environment Configuration
# NEVER commit real credentials to version control!

FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=change_this_to_a_secure_random_key_in_production
PORT=5000

# SQLite Database (relative to application root or absolute)
DATABASE_PATH=app/database/cinema.db

# JWT Configuration
JWT_SECRET=secure_jwt_token_signing_key_32_chars_minimum
JWT_EXPIRES_HOURS=168

# Razorpay Test Credentials (Day 5/6 Payment Integration)
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=rzp_test_placeholder_secret_key
